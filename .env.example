# The LAN-side biometric agent, configured entirely from here.
#
#   cp .env.example .env     # then fill in the four REQUIRED values
#   docker compose up -d
#
# For more than one terminal, use config.toml instead -- see config.example.toml.
# Anything set here still wins over that file, so credentials can live here and
# devices there.


# --- REQUIRED --------------------------------------------------------------

# Your production site, with https://
TK_BIOMETRIC_SITE_URL=https://erp.example.iq

# From the agent user on the site: Settings -> API Access -> Generate Keys.
# The secret is shown once.
TK_BIOMETRIC_API_KEY=
TK_BIOMETRIC_API_SECRET=

# Punches before this date are ignored, permanently.
#
# A terminal that has never been cleared holds years of punches, every one of
# them an HTTP request, and the Attendance they create lands in payroll periods
# that are already closed. The agent refuses to start without this.
TK_BIOMETRIC_IMPORT_START_DATE=2026-01-01

# The terminal, as reachable from *this machine* -- not from the site.
# Setting this is also the switch that says "one terminal, from the
# environment"; no config.toml needs to exist.
TK_BIOMETRIC_DEVICE_IP=192.168.1.50


# --- The terminal ----------------------------------------------------------

# Stamped verbatim onto every checkin this terminal produces, and what people
# filter the checkin report by. Letters, digits, hyphens and underscores only.
# Worth naming after the door. Defaults to "Terminal".
TK_BIOMETRIC_DEVICE_ID=Main-Door

# Which shifts this door feeds, comma-separated. Only read when
# TK_BIOMETRIC_UPDATE_SHIFT_LAST_SYNC is on, i.e. on a site without this app.
#
# Otherwise leave it empty and fill in the Shift Types table on the Biometric
# Device record in the desk instead -- one place, visible, and the site can see
# every site's terminals when deciding whether a shift is complete.
# TK_BIOMETRIC_DEVICE_SHIFTS=Day Shift

# AUTO  - the terminal reports IN/OUT properly; codes map per the values below
# IN    - a single-purpose entry door; the terminal's own code is ignored
# OUT   - a single-purpose exit door
# None  - leave the direction blank, for a Shift Type set to "Alternating entries"
#
# Many terminals only ever report code 255. Under AUTO that yields a checkin
# with no direction, which is correct -- it is not an error.
TK_BIOMETRIC_DEVICE_PUNCH_DIRECTION=AUTO

# The numeric COMM key set on the terminal; 0 if none.
TK_BIOMETRIC_DEVICE_COMM_KEY=0

# TK_BIOMETRIC_DEVICE_PORT=4370
# TK_BIOMETRIC_DEVICE_TIMEOUT=30

# pyzk falls back to UDP by itself when TCP is refused. Only force it if you
# know you need it -- TCP keeps large log reads from fragmenting.
# TK_BIOMETRIC_DEVICE_FORCE_UDP=false

# Wipe the terminal's memory, and only ever *after* every punch has landed on
# the site. Use it on a terminal whose memory fills up. On any other terminal
# leave it off: the device log is your only backup.
# TK_BIOMETRIC_DEVICE_CLEAR_AFTER_SYNC=false

# Stamped onto the checkin, if your site uses shift locations.
# TK_BIOMETRIC_DEVICE_LATITUDE=32.6160
# TK_BIOMETRIC_DEVICE_LONGITUDE=44.0249


# --- Everything else has a working default ---------------------------------

# Seconds between runs.
# TK_BIOMETRIC_INTERVAL=900

# Which Employee field holds the device user id: attendance_device_id or name.
# Leave it -- Frappe HR provides attendance_device_id for exactly this, on
# Employee -> Attendance -> Attendance Device ID.
# TK_BIOMETRIC_EMPLOYEE_FIELDNAME=attendance_device_id

# Which punch codes mean which direction, for a terminal set to AUTO.
# The defaults match stock ZKTeco firmware.
# TK_BIOMETRIC_PUNCH_VALUES_IN=0,4
# TK_BIOMETRIC_PUNCH_VALUES_OUT=1,5

# Leave this OFF unless your site does not have the teebatkarbala app.
#
# A site with the app advances Shift Type -> Last Sync of Checkin itself, every
# fifteen minutes, from the Shift Types table on each Biometric Device record --
# across every agent at every site. This agent can only ever see the terminals
# in its own config, so turning it on with a second site running means this
# agent declares the shift complete while the other site's terminal has said
# nothing, and everyone who punched there gets no check-out.
#
# Only for a site running stock Frappe HR, and only with exactly one agent.
# TK_BIOMETRIC_UPDATE_SHIFT_LAST_SYNC=false

# The sync cursor. Keep it on the volume the compose file mounts.
# TK_BIOMETRIC_STATE_FILE=/var/lib/tk-biometric-agent/state.json

# TK_BIOMETRIC_LOG_LEVEL=INFO

# The site's time zone, for log lines and the device-clock check. Punch
# timestamps come from the terminal and are passed through verbatim.
TZ=Asia/Baghdad

# --- Seeing the device in the desk -----------------------------------------

# Which machine this is, shown on the Biometric Device record so you can tell
# one agent from another. Defaults to the hostname, which in a container is the
# container id -- compose.yaml sets `hostname:` for this reason.
TK_BIOMETRIC_AGENT_HOST=office-nuc

# The agent registers its terminal on the site and heartbeats to it, so the
# module can show whether the device is connected. Harmless on a site that does
# not have the app: the agent notices once and stops trying.
# TK_BIOMETRIC_REPORT_TO_SITE=true
